rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return signedIn() && userRole() == 'admin'; }
    function isStaff() { return signedIn() && (userRole() == 'staff' || userRole() == 'admin'); }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // Self-registration creates only a staff account. Public users cannot self-assign admin.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role', 'email', 'createdAt'])
        && request.resource.data.role == 'staff'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt is timestamp;
      // Admins can promote/demote other users, but cannot change their own role.
      allow update: if isAdmin()
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['staff', 'admin'];
      allow delete: if false;
    }

    match /attendance/{recordId} {
      allow read: if isStaff()
        && (resource.data.uid == request.auth.uid || isAdmin());

      allow create: if isStaff()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day in [1, 2, 3]
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'day', 'clockIn', 'breakStart',
          'breakEnd', 'clockOut', 'status', 'updatedAt'
        ]);

      allow update: if isStaff()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.day == resource.data.day
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['clockIn', 'breakStart', 'breakEnd', 'clockOut', 'status', 'updatedAt']);

      allow delete: if isAdmin();
    }

    match /settings/{id} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /products/{id} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
          && request.resource.data.stock is number
          && request.resource.data.stock >= 0
          && request.resource.data.stock < resource.data.stock);
    }

    match /sales/{id} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.cashierUid == request.auth.uid
        && request.resource.data.voided == false
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.items is list;
      allow update: if isAdmin()
        && resource.data.voided == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['voided', 'voidedAt', 'voidedBy'])
        && request.resource.data.voided == true;
      allow delete: if false;
    }
  }
}
